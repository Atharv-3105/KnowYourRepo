# Copy to api/.env for local development (real environment variables always
# take precedence over this file). Everything below has a working default
# except DATABASE_URL's password.

APP_ENV=development          # "production" enables gin release mode
LOG_FORMAT=text              # "json" in production
PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/knowyourrepo?sslmode=disable
EXTRACTOR_URL=http://localhost:8000
# Must equal INTERNAL_API_KEY in extraction-service/.env
SIDECAR_API_KEY=

# Comma-separated browser origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Client-IP resolution for per-IP rate limits. 0 = use the TCP peer address
# (correct when nothing sits in front of the API). Behind N reverse proxies
# that each append to X-Forwarded-For, set N. Behind Cloudflare, set
# CLIENT_IP_HEADER=CF-Connecting-IP and TRUSTED_PROXY_HOPS=1.
TRUSTED_PROXY_HOPS=0
CLIENT_IP_HEADER=X-Forwarded-For

# Optional: raises the GitHub API limit for the pre-clone size check
# from 60 to 5000 requests/hour. A token with no scopes is enough.
GITHUB_TOKEN=

# Free-tier guardrails
INGESTION_WORKERS=1
MAX_REPO_SIZE_MB=150
MAX_REPO_FILES=2000
MAX_FILE_BYTES=524288
MAX_EMBED_CHUNKS=1024        # per ingestion run; the rest resumes next sync
EMBED_BATCH_ITEMS=128        # keep equal to OPENROUTER_EMBED_BATCH_SIZE
MAX_QUESTION_CHARS=2000
MAX_CHAT_SESSIONS=1000
CHAT_SESSION_TTL_MINUTES=1440
MAX_REQUEST_BODY_BYTES=65536
