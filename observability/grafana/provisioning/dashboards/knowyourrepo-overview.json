{
  "title": "KnowYourRepo Overview",
  "uid": "knowyourrepo-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "HTTP Request Rate (Go API)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (path, status) (rate(http_requests_total[1m]))",
          "legendFormat": "{{path}} [{{status}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "HTTP Request Latency p95 (Go API)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{path}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3,
      "title": "Agent Tool Executions",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (tool, outcome) (rate(agent_tool_executions_total[5m]))",
          "legendFormat": "{{tool}} [{{outcome}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "LLM Router Requests by Provider/Outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(llm_router_requests_total[5m]))",
          "legendFormat": "{{provider}} [{{outcome}}]",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Ingestion Job Duration (p50/p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, status) (rate(ingestion_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p50 [{{status}}]",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, status) (rate(ingestion_job_duration_seconds_bucket[15m])))",
          "legendFormat": "p95 [{{status}}]",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 6,
      "title": "Worker Pool Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "worker_pool_queue_depth",
          "legendFormat": "queue depth",
          "refId": "A"
        }
      ]
    }
  ]
}
