# Copy to .env and fill in. Every provider below has a free tier; nothing
# here requires a payment method.

# Postgres with the pgvector extension (shared with the Go API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowyourrepo

# Shared secret - must equal SIDECAR_API_KEY in the Go API's environment.
# Leave empty only for local development.
INTERNAL_API_KEY=

# --- Embeddings: OpenRouter free models -----------------------------------
# https://openrouter.ai/keys. Free models: 20 requests/min and 50 requests/day
# (1000/day once the account has bought >= $10 of credits).
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
# Must be <= the model's native dimension (nemotron-3-embed-1b: 2048, and it
# is Matryoshka-trained so it truncates cleanly). Changing model or dimension
# purges old vectors on startup; the Go API then re-embeds.
EMBED_DIMENSION=1024
EMBED_QUERY_PREFIX="query: "
EMBED_DOCUMENT_PREFIX="passage: "
OPENROUTER_EMBED_BATCH_SIZE=128
OPENROUTER_EMBED_RPM=20
OPENROUTER_EMBED_DAILY_LIMIT=50

# --- Chat LLMs (tried in order groq -> gemini -> cerebras -> openrouter) ----
# Only providers with a key are used; one is enough.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.3-70b
# The OpenRouter chat fallback reuses OPENROUTER_API_KEY. A ":free" chat model
# shares the same 50/day free-model quota as the embeddings above.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
